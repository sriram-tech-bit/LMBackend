{
  "name": "library-management-backend",
  "version": "1.0.0",
  "description": "REST API for a Library Management System (Express + Mongoose + JWT)",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node scripts/seed.js",
    "verify": "node scripts/verify-api.js",
    "test": "jest --runInBand --forceExit",
    "lint": "node --check src/server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "library"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
