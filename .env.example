# ---------------------------------------------------------------------------
# Copy this file to `.env` (same folder) and fill in your real values.
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env
# The app refuses to start if MONGODB_URI or JWT_SECRET is missing.
# ---------------------------------------------------------------------------

# --- Server ---
PORT=3000
NODE_ENV=development

# --- MongoDB ---
# Local:
#   mongodb://127.0.0.1:27017/library_management
# Local with auth:
#   mongodb://<user>:<password>@127.0.0.1:27017/library_management?authSource=admin
# MongoDB Atlas (SRV):
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/library_management?retryWrites=true&w=majority
#
# NOTE: if your password contains @ : / ? # or %, percent-encode it.
#   p@ss:w0rd  ->  p%40ss%3Aw0rd
MONGODB_URI=mongodb://127.0.0.1:27017/library_management

# Set to true only when pointing at a replica set / Atlas (enables multi-document
# transactions in the borrow flow). Leave false for a standalone local mongod.
MONGODB_TRANSACTIONS=false

# Optional tuning
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# --- Auth ---
# Use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=1d

# --- Librarian bootstrap account (used by `npm run seed`) ---
SEED_LIBRARIAN_NAME=Head Librarian
SEED_LIBRARIAN_EMAIL=librarian@library.test
SEED_LIBRARIAN_PASSWORD=Librarian@123

# --- Misc ---
DEFAULT_LOAN_DAYS=14
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=10
